{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smj-enterprise-os/schemas/dashboard-dataset-v1.json",
  "title": "Dashboard Dataset v1",
  "description": "The stable contract every presentation layer (PWA, Mobile, Desktop, TV Dashboard) consumes. Produced by src/dataset/datasetBuilder.js from the Reporting Service's own output (dashboard.json, dashboard-summary.json, dashboard-health.json) plus the Connector's run metadata. Never generated by reading Realm, the Connector, or a Business Service directly.",
  "type": "object",
  "required": [
    "metadata", "systemHealth", "businessUnits", "userRoles", "dashboardCards",
    "lastRefresh", "confidence", "freshness", "warnings", "blockedReasons",
    "unknownReasons", "approvalStatus", "dataLineage", "businessSummary"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["datasetVersion", "generatedAt", "generatedFrom"],
      "properties": {
        "datasetVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Semantic version of this contract shape. 1.0.0 for this sprint." },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generatedFrom": {
          "type": "object",
          "properties": {
            "reportingGeneratedAt": { "type": "string", "format": "date-time" },
            "connectorRunId": { "type": ["string", "null"] }
          }
        }
      }
    },
    "systemHealth": {
      "type": "object",
      "required": ["connector", "canonical", "reporting", "validation", "lastSuccessfulRefresh", "snapshotClassification", "schemaVersion", "sourceBackup"],
      "properties": {
        "connector": { "type": "string", "enum": ["healthy", "degraded", "unhealthy", "unavailable"] },
        "canonical": { "type": "string", "enum": ["healthy", "degraded", "unhealthy", "unavailable"] },
        "reporting": { "type": "string", "enum": ["healthy", "degraded", "unhealthy", "unavailable"] },
        "validation": { "type": "string", "enum": ["healthy", "degraded", "unhealthy", "unavailable"] },
        "lastSuccessfulRefresh": { "type": ["string", "null"], "format": "date-time" },
        "snapshotClassification": { "type": ["string", "null"], "enum": ["COMPLETE_DAY", "PARTIAL_DAY", "MID_SHIFT", "UNKNOWN", null] },
        "schemaVersion": { "type": ["integer", "null"] },
        "sourceBackup": {
          "type": ["object", "null"],
          "properties": {
            "sourceFile": { "type": "string" },
            "sourceChecksum": { "type": "string" },
            "connectorVersion": { "type": "string" }
          }
        }
      }
    },
    "businessUnits": {
      "type": "array",
      "description": "Schema preparation only — no multi-business logic. See implementation notes for grounding per entry.",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "dataConnected", "authoritativeSources", "businessOwner", "groundedIn"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "not-onboarded"] },
          "dataConnected": { "type": "boolean" },
          "businessOwner": { "type": "string" },
          "groundedIn": { "type": "string" }
        }
      }
    },
    "userRoles": {
      "type": "array",
      "description": "Visibility metadata only — no authentication, no enforcement.",
      "items": {
        "type": "object",
        "required": ["id", "name", "visibilityScope", "groundedIn"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "visibilityScope": { "type": "string" },
          "groundedIn": { "type": "string" }
        }
      }
    },
    "dashboardCards": {
      "type": "array",
      "description": "Exactly the 11 cards documented in implementation/dashboard-v2-implementation-plan.md §3.",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "name", "value", "status", "lastUpdated", "dataFreshness", "sourceEntity", "businessService", "confidence", "audit", "approvalStatus"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "value": { "description": "A number, or the literal string \"UNKNOWN\" — never a fabricated placeholder." },
          "status": { "type": "string", "enum": ["ok", "unavailable", "blocked"] },
          "lastUpdated": { "type": "string", "format": "date-time" },
          "dataFreshness": {
            "type": "object",
            "properties": {
              "latestDataDate": { "type": ["string", "null"] },
              "ingestedAt": { "type": ["string", "null"] },
              "ageInDays": { "type": ["integer", "null"] }
            }
          },
          "sourceEntity": { "type": "string" },
          "businessService": { "type": "string" },
          "confidence": { "type": "string", "enum": ["High", "Medium", "Low", "N/A"] },
          "caveat": { "type": "string" },
          "audit": {
            "type": "object",
            "required": ["sourceEntity", "businessService", "reportingModule", "refreshTimestamp", "confidence", "currentStatus", "lineage"],
            "properties": {
              "sourceEntity": { "type": "string" },
              "businessService": { "type": "string" },
              "reportingModule": { "type": "string" },
              "refreshTimestamp": { "type": "string" },
              "confidence": { "type": "string" },
              "currentStatus": { "type": "string" },
              "lineage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["stage", "value"],
                  "properties": { "stage": { "type": "string" }, "value": {} }
                }
              }
            }
          },
          "approvalStatus": { "type": "string", "enum": ["not-tracked"], "description": "Always \"not-tracked\" today — no AI Session or Automation Job record exists anywhere in this pipeline yet (Business Rules Catalog GOV-004, AI-005)." }
        }
      }
    },
    "lastRefresh": { "type": ["string", "null"], "format": "date-time" },
    "confidence": {
      "type": "object",
      "description": "A distribution across the 11 cards, not a single blended score.",
      "required": ["High", "Medium", "Low", "N/A"],
      "properties": {
        "High": { "type": "integer" }, "Medium": { "type": "integer" }, "Low": { "type": "integer" }, "N/A": { "type": "integer" }
      }
    },
    "freshness": { "type": "object", "description": "Reused verbatim from the Reporting Service's dashboard-health.json freshness block." },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "message", "severity"],
        "properties": { "source": { "type": "string" }, "check": { "type": "string" }, "message": { "type": "string" }, "severity": { "type": "string" } }
      }
    },
    "blockedReasons": {
      "type": "array",
      "items": { "type": "object", "required": ["cardId", "reason"], "properties": { "cardId": { "type": "string" }, "reason": { "type": "string" } } }
    },
    "unknownReasons": {
      "type": "array",
      "items": { "type": "object", "required": ["cardId", "reason"], "properties": { "cardId": { "type": "string" }, "reason": { "type": "string" } } }
    },
    "approvalStatus": {
      "type": "object",
      "required": ["mechanism", "governingRule", "note"],
      "properties": {
        "mechanism": { "type": "string", "enum": ["not-yet-implemented"] },
        "governingRule": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "dataLineage": {
      "type": "object",
      "required": ["pipeline", "reference", "sourceChecksum", "reconciliation"],
      "properties": {
        "pipeline": { "type": "array", "items": { "type": "string" } },
        "reference": { "type": "string" },
        "sourceChecksum": { "type": ["string", "null"] },
        "reconciliation": { "type": "object" }
      }
    },
    "businessSummary": { "type": "object", "description": "The Reporting Service's own dashboard-summary.json, embedded verbatim." }
  }
}
